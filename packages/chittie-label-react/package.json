{
  "name": "@angadie/chittie-label-react",
  "version": "0.5.1",
  "description": "Pure JSX authoring for TSPL labels → bytes. Positioned <LText>/<LBarcode>/<LQR>/<LBox>/<LImage> on a <Label>. RN-safe (no react-dom). Renders onto chittie-label.",
  "license": "MIT",
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "tsx spikes/jsx.spike.tsx"
  },
  "dependencies": {
    "@angadie/chittie-label": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  },
  "devDependencies": {
    "@canvas/image-data": "^1.1.0",
    "react": "^19.1.0",
    "@types/react": "^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
