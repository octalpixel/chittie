{
  "name": "@angadie/chittie-react-native",
  "version": "0.1.0",
  "description": "React Native (Nitro) backend for chittie: native non-Latin text rasterization (CoreText / android.graphics) implementing chittie's TextRasterizer. Dev-client / bare RN — not Expo Go.",
  "license": "MIT",
  "author": "angadie",
  "homepage": "https://github.com/octalpixel/chittie#readme",
  "repository": "https://github.com/octalpixel/chittie.git",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "nitrogen",
    "nitro.json",
    "android/build.gradle",
    "android/CMakeLists.txt",
    "android/gradle.properties",
    "android/fix-prefab.gradle",
    "android/src",
    "ios/**/*.swift",
    "app.plugin.js",
    "*.podspec",
    "README.md"
  ],
  "scripts": {
    "codegen": "nitrogen --logLevel=\"debug\"",
    "build": "tsc --noEmit && bob build",
    "typecheck": "tsc --noEmit",
    "test": "tsx spikes/adapter.spike.mts",
    "clean": "rm -rf lib"
  },
  "keywords": [
    "react-native",
    "nitro",
    "nitro-module",
    "thermal-printer",
    "escpos",
    "chittie"
  ],
  "peerDependencies": {
    "@angadie/chittie-text": ">=0.8.1",
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": "*"
  },
  "devDependencies": {
    "@angadie/chittie-text": "workspace:*",
    "@canvas/image-data": "^1.1.0",
    "nitrogen": "0.35.1",
    "react-native-builder-bob": "^0.40.18",
    "react-native-nitro-modules": "0.35.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.json"
        }
      ]
    ]
  }
}
