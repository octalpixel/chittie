{
  "name": "@angadie/chittie-react",
  "version": "0.10.0",
  "description": "Pure JSX receipt authoring → ESC/POS bytes. RN-safe (no react-dom, no HTML host elements). Renders onto chittie-core.",
  "license": "MIT",
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "tsx spikes/jsx.spike.tsx"
  },
  "dependencies": {
    "@angadie/chittie-core": "workspace:*",
    "@angadie/chittie-text": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  },
  "devDependencies": {
    "@canvas/image-data": "^1.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
