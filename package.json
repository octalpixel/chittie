{
  "name": "@angadie/chittie-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "chittie — receipt/printing engine for the angadie OSS POS system. Web + React Native/Expo, JSX + builder, library-agnostic transports.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
