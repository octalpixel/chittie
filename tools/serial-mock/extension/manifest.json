{
  "manifest_version": 3,
  "name": "Chittie Serial Mock",
  "version": "1.0.0",
  "description": "Dev-only: replaces navigator.serial with a mock that captures ESC/POS bytes and forwards them to the local render server. No hardware needed.",
  "host_permissions": ["http://localhost/*"],
  "content_scripts": [
    {
      "matches": ["http://localhost:5173/*", "http://localhost:3000/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["http://localhost:5173/*", "http://localhost:3000/*"],
      "js": ["relay.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
